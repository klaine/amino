        },
        {
            "title": "Layers",
            "lines": [
                "Layers sets how many",
                "layers sound (1-4).",
                "",
                "Stack layers them.",
                "RoundRb rotates per",
                "note. RandRR picks",
                "randomly. Split uses",
                "keys. Chan uses MIDI",
                "channels.",
                "",
                "Edit chooses the",
                "layer every layer",
                "page edits.",
                "The header shows L1",
                "to L4 when Layers",
                "is above 1.",
                "",
                "Hold Copy and pick",
                "a layer to copy it.",
                "Hold Delete and pick",
                "a layer to clear it.",
                "Undo reverses that."
            ]
        },
        {
            "title": "Expression",
            "lines": [
                "Pads send notes and",
                "poly aftertouch.",
                "",
                "Play page:",
                "VW1 VW2 VFlt VAmp",
                "set velocity depth.",
                "Kbd tracks cutoff.",
                "ATWav ATCut ATVib",
                "set pressure depth.",
                "",
                "Bend range is on",
                "the Layers page.",
                "MPE On gives per-",
                "note bend, pressure",
                "and timbre."
            ]
        },
        {
            "title": "MIDI CC",
            "lines": [
                "CC1: Mod wheel",
                "CC2: Breath",
                "CC4: Foot",
                "CC11: Expression",
                "CC64: Sustain",
                "CC74: Timbre",
                "CC120: Ch sound off",
                "CC121: Reset CCs",
                "CC123: Ch notes off"
            ]
        },
        {
            "title": "Mod Sources",
            "lines": [
                "Off, Wave Env,",
                "Filter Env, Amp Env,",
                "LFO1, LFO2, LFO1xMW,",
                "LFO2xMW, Velocity,",
                "Release Vel, Key,",
                "Poly AT, Chan AT,",
                "ModWheel, Breath,",
                "Foot, Expression,",
                "Pitch Bend, Timbre,",
                "Sustain, Random,",
                "Random Bi, Voice #,",
                "Layer Alt, Constant,",
                "Flavour, Aux Env."
            ]
        },
        {
            "title": "Mod Targets",
            "lines": [
                "Off, Pitch,",
                "Osc1/Osc2 Pitch,",
                "Osc1/Osc2 Wave,",
                "Osc1/Osc2 Level,",
                "Dirt Level, Cutoff,",
                "Resonance, Drive,",
                "Pan, Amp Level,",
                "LFO1/LFO2 Rate,",
                "LFO1/LFO2 Depth,",
                "E1/E2/E3 Decay,",
                "E1 Attack,",
                "E3 Release, Glide,",
                "FX Send, XMod."
            ]
        },
        {
            "title": "Effects",
            "lines": [
                "11 types: Chorus,",
                "Flanger, Phaser,",
                "Tremolo, Drive,",
                "Comp, EQ, Delay,",
                "Reverb, Shimmer,",
                "Trance Gate.",
                "",
                "FX1 and FX2 each",
                "have Type and Mix.",
                "Chain runs them in",
                "Parallel or Serial.",
                "",
                "Layer route picks",
                "Dry, FX1 or FX2.",
                "Send feeds the FX.",
                "Type pages name",
                "their six knobs."
            ]
        },
        {
            "title": "Tips",
            "lines": [
                "Touch a knob to see",
                "its full name.",
                "Shift+turn is fine.",
                "",
                "Envelopes are drawn",
                "on their own page.",
                "Viz groups fill a",
                "whole row of four.",
                "",
                "The state blob saves",
                "every key, so old",
                "presets keep their",
                "sound after updates."
            ]
        }
    ]
}
